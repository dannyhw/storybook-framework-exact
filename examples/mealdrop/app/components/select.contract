use Label from "./typography.contract"

// A choice from a short known list: the browser's own select, restyled, with the design's chevron over
// it. Controlled: it shows `value` and calls `change` with the chosen option. Without a label, `name` is
// its accessible name.
component Select
  props
    label: string
    name: string
    value: string
    options: string[]
    change: action
  view
    column padding-bottom="space.sm"
      if label != ""
        row color="text.label" padding-bottom="space.xxs"
          Label(label=`${label.slice(0, 1).toUpperCase()}${label.slice(1)}`, size=18, weight=400)
      row position="relative"
        select value=value change=change aria-label=(label != "" ? label : name) testId=`select-${name}`
          flex=1 appearance="none" border-width=0 border-radius="radius.control" padding="13px 36px 13px 16px"
          color="text.primary" background-color="surface.sunken" font-family="Hind, sans-serif" font-size=16 line-height=1.2
          for option in options key=option
            option option value=option
        row position="absolute" top=0 bottom=0 right=8 align-items="center" pointer-events="none" color="icon.default"
          svg width=16 height=16 viewBox="0 0 448 512" aria-hidden="true"
            path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"
