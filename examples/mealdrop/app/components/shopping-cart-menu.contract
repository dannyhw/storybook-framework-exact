use Body, Label from "./typography.contract"
use Button from "./button.contract"
use Select from "./select.contract"
use Sidebar, SidebarBody, SidebarFooter from "./sidebar.contract"
use CartItem, cartTotal, money from "../data/shapes.contract"

// Button's filled look, drawn here so the checkout button can take the footer's whole width.
style Checkout
  display="flex" box-sizing="border-box" align-items="center" justify-content="center" width="100%" padding="18px 16px" border="0"
  border-radius="radius.control" cursor="pointer" transition="background-color 150ms ease-in"
  background-color = "action.primary"
  color = "action.on-primary"
  :hover
    background-color = "action.primary-hover"
  :focus-visible
    box-shadow = "0 0 0 1px focus.ring, 0 0 0 4px focus.halo"
  :disabled
    opacity = 0.4

// The cart in a `Sidebar`: each item with a quantity picker, the total, and the way to checkout. Picking 0
// takes the item out (`removeItem` with its id); another number calls `saveItem` with the id and it.
component ShoppingCartMenu
  props
    open: bool
    cartItems: CartItem[]
    currency: enum<"EUR", "USD">
    compact: bool
    dismiss: action
    saveItem: action
    removeItem: action
    checkout: action
  derive total = cartTotal(cartItems)
  view
    Sidebar(open=open, title="Your order", compact=compact, dismiss=dismiss)
      SidebarBody()
        column gap="space.sm"
          for item in cartItems key=item.id
            ShoppingCartMenuItem(item=item, currency=currency, saveItem=saveItem, removeItem=removeItem)
      SidebarFooter()
        column width="100%" justify-content="space-between"
          row justify-content="space-between" margin-bottom="space.sm" testId="cart-total"
            Body(label="Total", size="M", weight="regular")
            Body(label=money(total, currency), size="M", weight="regular")
          button class=Checkout press=checkout disabled=(total == 0) testId="checkout"
            Label(label="Checkout", size=16, weight=400)

// One item of the cart: its name, description and price, and how many.
component ShoppingCartMenuItem
  props
    item: CartItem
    currency: enum<"EUR", "USD">
    saveItem: action
    removeItem: action
  derive quantities = range(11).map(n => n.toString())
  action pick(value: string)
    match parseNumber(value)
      case some(n)
        if n == 0
          removeItem(item.id)
        else
          saveItem(item.id, n)
      case none
        removeItem(item.id)
  view
    row align-items="flex-start" testId=`cart-item-${item.id}`
      column flex=0.75 padding-right="space.xs" gap="space.xxxs"
        Body(label=item.name, size="M", weight="medium")
        if item.description != ""
          Body(label=item.description, size="M", weight="regular")
        Body(label=money(item.price * item.quantity, currency), size="M", weight="regular")
      column flex=0.25
        Select(label="", name=`${item.quantity} ${item.quantity == 1 ? "time" : "times"}`, value=item.quantity.toString(), options=quantities, change=pick)

// Mealdrop's stories: the page under the cart, which opens at once. `withOpener` adds the line of text
// and the button that opens it again, as the Playground story has.
component ShoppingCartMenuExample
  props
    cartItems: CartItem[]
    currency: enum<"EUR", "USD">
    compact: bool
    withOpener: bool
    dismiss: action
    saveItem: action
    removeItem: action
    checkout: action
  state open = true
  action show
    open = true
    focus("sidebar-panel")
  action hide
    open = false
    dismiss()
  view
    column position="relative" gap="space.xs" padding="space.xs" height="100vh" box-sizing="border-box" overflow="hidden"
      if withOpener
        Body(label="Press ESC to close the ShoppingCartMenu or click on the close icon!", size="M", weight="regular")
        Button(label="Open ShoppingCartMenu", icon="none", clear=false, round=false, large=false, disabled=false, press=show)
      ShoppingCartMenu(open=open, cartItems=cartItems, currency=currency, compact=compact, dismiss=hide, saveItem=saveItem,
        removeItem=removeItem, checkout=checkout)
