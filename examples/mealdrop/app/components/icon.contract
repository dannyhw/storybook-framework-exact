// The design system's icons: drawn in line, in the colour of the text around them. All but the star are
// stroked on a 24-unit grid; the star is Droppy's 20-unit outline, drawn with a thinner line.
component Icon
  props
    name: enum<"none", "arrow-right", "arrow-left", "cross", "cart", "minus", "plus", "moon", "sun", "star">
    size: number
  view
    svg width=size height=size min-width=size viewBox=(name == "star" ? "0 0 20 20" : "0 0 24 24") fill="none" stroke="currentColor" stroke-width=(name == "star" ? 1 : 2) stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" testId=`icon-${name}`
      if name == "arrow-right"
        line x1=5 y1=12 x2=19 y2=12
        polyline points="12 5 19 12 12 19"
      if name == "arrow-left"
        line x1=19 y1=12 x2=5 y2=12
        polyline points="12 19 5 12 12 5"
      if name == "cross"
        line x1=18 y1=6 x2=6 y2=18
        line x1=6 y1=6 x2=18 y2=18
      if name == "cart"
        circle cx=9 cy=21 r=1
        circle cx=20 cy=21 r=1
        path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
      if name == "minus"
        line x1=5 y1=12 x2=19 y2=12
      if name == "plus"
        line x1=12 y1=5 x2=12 y2=19
        line x1=5 y1=12 x2=19 y2=12
      if name == "moon"
        path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      if name == "sun"
        circle cx=12 cy=12 r=5
        line x1=12 y1=1 x2=12 y2=3
        line x1=12 y1=21 x2=12 y2=23
        line x1=4.22 y1=4.22 x2=5.64 y2=5.64
        line x1=18.36 y1=18.36 x2=19.78 y2=19.78
        line x1=1 y1=12 x2=3 y2=12
        line x1=21 y1=12 x2=23 y2=12
        line x1=4.22 y1=19.78 x2=5.64 y2=18.36
        line x1=18.36 y1=5.64 x2=19.78 y2=4.22
      if name == "star"
        path d="M19.947 7.179C19.818 6.801 19.477 6.534 19.079 6.503L13.378 6.05L10.911 0.589C10.75 0.23 10.393 0 10 0C9.607 0 9.25 0.23 9.089 0.588L6.622 6.05L0.921 6.503C0.53 6.534 0.193 6.791 0.06 7.16C-0.073 7.529 0.021 7.942 0.302 8.216L4.515 12.323L3.025 18.775C2.933 19.174 3.094 19.589 3.431 19.822C3.603 19.94 3.801 20 4 20C4.193 20 4.387 19.944 4.555 19.832L10 16.202L15.445 19.832C15.793 20.064 16.25 20.055 16.59 19.808C16.928 19.561 17.077 19.128 16.962 18.726L15.133 12.326L19.669 8.244C19.966 7.976 20.075 7.558 19.947 7.179Z"
