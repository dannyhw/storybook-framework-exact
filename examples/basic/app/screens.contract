routes nav
  fruits "/"
    fruit "/fruit/:name"
  notfound

component Screens
  action open(name: string)
    nav = push(nav, path("fruit", name))
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)

  view
    main navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "fruits"
          column navigationKey=`${e.id}` position="absolute" inset=0 padding=16 gap=12
            text "Fruits" role="heading" aria-level=1
            for name in ["apple", "pear", "plum"] key=name
              button press=open(name) testId=`open-${name}`
                text name
        if e.name == "fruit"
          column navigationKey=`${e.id}` position="absolute" inset=0 padding=16 gap=12
            text e.params.name role="heading" aria-level=1
            text `A page of its own for the ${e.params.name}.`
            button press=back testId="back"
              text "Back to the fruits"
        if e.name == "notfound"
          column navigationKey=`${e.id}` position="absolute" inset=0 padding=16 gap=12
            text "Nothing here" role="heading" aria-level=1
            link href=path("fruits")
              text "All fruits"
