{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "contentMappers": [{ "package": "storybook-framework-exact", "extensions": [".contract"] }],
  "include": ["app", "lib", ".storybook"]
}
